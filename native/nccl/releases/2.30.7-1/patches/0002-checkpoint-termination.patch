+
+// Checkpoint-only synchronous abort. Unlike the public ncclCommAbort API,
+// this does not return while commReclaim is still running on an async thread.
+// The checkpoint shim calls it for every communicator in the process, so the
+// final local communicator reclaims the shared resources for the full group.
+NCCL_API(ncclResult_t, ncclCheckpointCommAbortSync, ncclComm_t comm);
+ncclResult_t ncclCheckpointCommAbortSync(ncclComm_t comm) {
+  if (comm == NULL) return ncclSuccess;
+
+  NCCLCHECK(setCommAbortFlags(comm, 1));
+  comm->destroyFlag = 1;
+  (void)ncclCommEnsureReady(comm);
+
+  struct ncclCommFinalizeAsyncJob job;
+  job.comm = comm;
+  return commReclaim((struct ncclAsyncJob*)&job);
+}
