+enum CheckpointTermination {
+  checkpoint_termination_destroy,
+  checkpoint_termination_abort,
+  checkpoint_termination_abort_sync,
+};
+
+static ncclResult_t checkpointTerminationFromEnv(CheckpointTermination* termination) {
+  const char* value = std::getenv("NCCL_CHECKPOINT_TERMINATION");
+  if (value == nullptr || value[0] == '\0' || std::strcmp(value, "destroy") == 0) {
+    *termination = checkpoint_termination_destroy;
+    return ncclSuccess;
+  }
+  if (std::strcmp(value, "abort") == 0) {
+    *termination = checkpoint_termination_abort;
+    return ncclSuccess;
+  }
+  if (std::strcmp(value, "abort-sync") == 0) {
+    *termination = checkpoint_termination_abort_sync;
+    return ncclSuccess;
+  }
+  WARN("NCCL_CHECKPOINT_TERMINATION must be 'destroy', 'abort', or 'abort-sync', got '%s'", value);
+  return ncclInvalidArgument;
+}
+
+static const char* checkpointTerminationString(CheckpointTermination termination) {
+  switch (termination) {
+  case checkpoint_termination_abort:
+    return "abort";
+  case checkpoint_termination_abort_sync:
+    return "abort-sync";
+  case checkpoint_termination_destroy:
+    return "destroy";
+  }
+  return "unknown";
+}
