+  NCCLCHECK(ncclRasCheckpointReset());
+  // The checkpoint shim has destroyed every communicator, but unsuccessful
+  // network/GIN probes can leave unmatched device-cache references behind.
+  // Force the same last-user path at this explicit checkpoint boundary.
+  netRefCount = 1;
+  return ncclIbFinalizeDevices();
+}
