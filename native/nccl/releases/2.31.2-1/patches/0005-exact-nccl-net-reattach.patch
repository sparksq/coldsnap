+// Exact-version experimental ABI used by ColdSnap's in-place NCCL provider.
+// The endpoint is deliberately transport-opaque: the provider coordinates the
+// bytes, while this matching NCCL build owns their interpretation.
+struct coldsnapNcclNetEndpoint {
+  uint32_t structSize;
+  uint32_t version;
+  int32_t senderRank;
+  int32_t receiverRank;
+  int32_t channelId;
+  int32_t connIndex;
+  ncclNetHandle_t handle;
 };
 
+#define COLDSNAP_NCCL_NET_ENDPOINT_VERSION 1
+
