+NCCL_API(ncclResult_t, ncclCheckpointNetReattach, ncclComm_t comm,
+         struct coldsnapNcclNetEndpoint* sendEndpoints, int sendEndpointCount);
+ncclResult_t ncclCheckpointNetReattach(ncclComm_t comm, struct coldsnapNcclNetEndpoint* sendEndpoints,
+                                        int sendEndpointCount) {
+  if (sendEndpointCount < 0 || (sendEndpointCount != 0 && sendEndpoints == NULL)) return ncclInvalidArgument;
+  NCCLCHECK(coldsnapCheckNetBoundary(comm));
+  struct ncclProxyState* proxyState = comm->proxyState;
+  std::vector<struct ncclProxyConnection*> sends;
+  std::vector<struct ncclProxyConnection*> recvs;
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 1, [&](struct ncclProxyConnection* connection) {
+    sends.push_back(connection);
+    return ncclSuccess;
+  }));
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 0, [&](struct ncclProxyConnection* connection) {
+    recvs.push_back(connection);
+    return ncclSuccess;
+  }));
+  if ((int)sends.size() != sendEndpointCount) return ncclInvalidArgument;
+
+  std::vector<struct coldsnapNcclNetEndpoint*> matched(sends.size(), NULL);
+  for (size_t i = 0; i < sends.size(); i++) {
+    struct sendNetResources* resources = (struct sendNetResources*)sends[i]->transportResources;
+    for (int j = 0; j < sendEndpointCount; j++) {
+      if (coldsnapEndpointMatches(sendEndpoints + j, resources->tpRank, resources->tpRemoteRank,
+                                  resources->channelId, resources->connIndex)) {
+        matched[i] = sendEndpoints + j;
+        break;
+      }
+    }
+    if (matched[i] == NULL) return ncclInvalidArgument;
+  }
+
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(120);
+  for (;;) {
+    bool complete = true;
+    for (size_t i = 0; i < sends.size(); i++) {
+      struct sendNetResources* resources = (struct sendNetResources*)sends[i]->transportResources;
+      if (!resources->checkpointDetached) continue;
+      if (resources->netSendComm == NULL) {
+        ncclNetDeviceHandle_t* deviceHandle = NULL;
+        NCCLCHECK(proxyState->ncclNet->connect(proxyState->netContext, resources->netDev, matched[i]->handle,
+                                               &resources->netSendComm, &deviceHandle));
+        if (deviceHandle != NULL) return ncclInvalidUsage;
+      }
+      if (resources->netSendComm == NULL) complete = false;
+    }
+    for (struct ncclProxyConnection* connection : recvs) {
+      struct recvNetResources* resources = (struct recvNetResources*)connection->transportResources;
+      if (!resources->checkpointDetached) continue;
+      if (resources->netRecvComm == NULL) {
+        ncclNetDeviceHandle_t* deviceHandle = NULL;
+        NCCLCHECK(proxyState->ncclNet->accept(resources->netListenComm, &resources->netRecvComm, &deviceHandle));
+        if (deviceHandle != NULL) return ncclInvalidUsage;
+      }
+      if (resources->netRecvComm == NULL) complete = false;
+    }
+    if (complete) break;
+    if (std::chrono::steady_clock::now() >= deadline) {
+      WARN("ColdSnap in-place NET reattach timed out");
+      return ncclSystemError;
+    }
+    std::this_thread::yield();
+  }
+
+  for (struct ncclProxyConnection* connection : recvs) {
+    struct recvNetResources* resources = (struct recvNetResources*)connection->transportResources;
+    NCCLCHECK(proxyState->ncclNet->closeListen(resources->netListenComm));
+    resources->netListenComm = NULL;
+    NCCLCHECK(coldsnapRegisterRecv(connection, proxyState));
+  }
+  for (struct ncclProxyConnection* connection : sends) {
+    NCCLCHECK(coldsnapRegisterSend(connection, proxyState));
+  }
+  return ncclSuccess;
+}
