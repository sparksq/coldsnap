+NCCL_API(ncclResult_t, ncclCheckpointNetDetach, ncclComm_t comm);
+ncclResult_t ncclCheckpointNetDetach(ncclComm_t comm) {
+  NCCLCHECK(coldsnapCheckNetBoundary(comm));
+  struct ncclProxyState* proxyState = comm->proxyState;
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 1, [&](struct ncclProxyConnection* connection) {
+    return coldsnapDetachSend(connection, proxyState);
+  }));
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 0, [&](struct ncclProxyConnection* connection) {
+    return coldsnapDetachRecv(connection, proxyState);
+  }));
+  NCCLCHECK(comm->ncclNet->finalize(comm->netContext));
+  comm->netContext = NULL;
+  proxyState->netContext = NULL;
+  return ncclSuccess;
+}
