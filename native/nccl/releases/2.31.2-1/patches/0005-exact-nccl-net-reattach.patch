+NCCL_API(ncclResult_t, ncclCheckpointNetReinitialize, ncclComm_t comm);
+ncclResult_t ncclCheckpointNetReinitialize(ncclComm_t comm) {
+  NCCLCHECK(coldsnapCheckNetBoundary(comm));
+  if (comm->netContext != NULL || comm->proxyState->netContext != NULL) return ncclInvalidUsage;
+  ncclNetCommConfig_t commConfig = {};
+  commConfig.trafficClass = comm->config.trafficClass == NCCL_CONFIG_UNDEF_INT ?
+                              NCCL_NET_TRAFFIC_CLASS_UNDEF : comm->config.trafficClass;
+  NCCLCHECK(comm->ncclNet->init(&comm->netContext, comm->commHash, &commConfig, ncclDebugLog,
+                                ncclProfilerCallback));
+  comm->proxyState->netContext = comm->netContext;
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclCheckpointNetRecvEndpoints, ncclComm_t comm,
+         struct coldsnapNcclNetEndpoint* endpoints, int capacity, int* count);
+ncclResult_t ncclCheckpointNetRecvEndpoints(ncclComm_t comm, struct coldsnapNcclNetEndpoint* endpoints, int capacity,
+                                             int* count) {
+  if (count == NULL || capacity < 0 || (capacity != 0 && endpoints == NULL)) return ncclInvalidArgument;
+  NCCLCHECK(coldsnapCheckNetBoundary(comm));
+  int required = 0;
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 0, [&](struct ncclProxyConnection*) {
+    required++;
+    return ncclSuccess;
+  }));
+  *count = required;
+  if (capacity < required) return endpoints == NULL ? ncclSuccess : ncclInvalidArgument;
+  if (endpoints == NULL) return ncclSuccess;
+
+  int index = 0;
+  struct ncclProxyState* proxyState = comm->proxyState;
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 0, [&](struct ncclProxyConnection* connection) {
+    struct recvNetResources* resources = (struct recvNetResources*)connection->transportResources;
+    if (resources == NULL || !resources->checkpointDetached || resources->netRecvComm != NULL) {
+      return ncclInvalidUsage;
+    }
+    // NCCL closes the initial setup listener after accept but intentionally
+    // leaves the opaque pointer value in netListenComm.  Once the receive
+    // transport is checkpoint-detached that value is stale, not a live
+    // listener, and must be replaced by the new activation epoch.
+    resources->netListenComm = NULL;
+    coldsnapEndpointIdentity(endpoints + index, resources->tpRemoteRank, resources->tpRank, resources->channelId,
+                             resources->connIndex);
+    NCCLCHECK(proxyState->ncclNet->listen(proxyState->netContext, resources->netDev, endpoints[index].handle,
+                                          &resources->netListenComm));
+    index++;
+    return ncclSuccess;
+  }));
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclCheckpointNetSendEndpoints, ncclComm_t comm,
+         struct coldsnapNcclNetEndpoint* endpoints, int capacity, int* count);
+ncclResult_t ncclCheckpointNetSendEndpoints(ncclComm_t comm, struct coldsnapNcclNetEndpoint* endpoints, int capacity,
+                                             int* count) {
+  if (count == NULL || capacity < 0 || (capacity != 0 && endpoints == NULL)) return ncclInvalidArgument;
+  NCCLCHECK(coldsnapCheckNetBoundary(comm));
+  int required = 0;
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 1, [&](struct ncclProxyConnection*) {
+    required++;
+    return ncclSuccess;
+  }));
+  *count = required;
+  if (capacity < required) return endpoints == NULL ? ncclSuccess : ncclInvalidArgument;
+  if (endpoints == NULL) return ncclSuccess;
+
+  int index = 0;
+  NCCLCHECK(coldsnapForEachNetConnection(comm, 1, [&](struct ncclProxyConnection* connection) {
+    struct sendNetResources* resources = (struct sendNetResources*)connection->transportResources;
+    if (resources == NULL || !resources->checkpointDetached || resources->netSendComm != NULL) {
+      return ncclInvalidUsage;
+    }
+    coldsnapEndpointIdentity(endpoints + index, resources->tpRank, resources->tpRemoteRank, resources->channelId,
+                             resources->connIndex);
+    index++;
+    return ncclSuccess;
+  }));
+  return ncclSuccess;
+}
