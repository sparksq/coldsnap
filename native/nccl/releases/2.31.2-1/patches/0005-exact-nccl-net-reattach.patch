+static bool coldsnapUsedIb = false;
+
+template <typename Function>
+static ncclResult_t coldsnapForEachNetConnection(struct ncclComm* comm, int send, Function function) {
+  std::unordered_set<struct ncclProxyConnection*> visited;
+  for (int channelId = 0; channelId < MAXCHANNELS; channelId++) {
+    struct ncclChannel* channel = comm->channels + channelId;
+    if (channel->peers == NULL) continue;
+    for (int peerRank = 0; peerRank < comm->nRanks; peerRank++) {
+      struct ncclChannelPeer* peer = channel->peers[peerRank];
+      if (peer == NULL) continue;
+      for (int connIndex = 0; connIndex < NCCL_MAX_CONNS; connIndex++) {
+        struct ncclConnector* connector = send ? peer->send + connIndex : peer->recv + connIndex;
+        if (!connector->connected || !connector->proxyConn.initialized || connector->proxyConn.connection == NULL) {
+          continue;
+        }
+        if (!connector->proxyConn.sameProcess) {
+          WARN("ColdSnap in-place NET requires a process-local proxy connection");
+          return ncclInvalidUsage;
+        }
+        struct ncclProxyConnection* connection = connector->proxyConn.connection;
+        if (connection->transport != TRANSPORT_NET || connection->send != send) continue;
+        if (!visited.insert(connection).second) continue;
+        NCCLCHECK(function(connection));
+      }
+    }
+  }
+  return ncclSuccess;
+}
+
+static ncclResult_t coldsnapCheckNetBoundary(struct ncclComm* comm) {
+  if (comm == NULL || comm->endMagic != NCCL_MAGIC || comm->proxyState == NULL) return ncclInvalidArgument;
+  const auto idleDeadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (COMPILER_ATOMIC_LOAD(&comm->proxyState->progressState.active, std::memory_order_acquire) != NULL &&
+         std::chrono::steady_clock::now() < idleDeadline) {
+    std::this_thread::yield();
+  }
+  if (COMPILER_ATOMIC_LOAD(&comm->proxyState->progressState.active, std::memory_order_acquire) != NULL) {
+    WARN("ColdSnap in-place NET detach requires an idle proxy progress queue");
+    return ncclInvalidUsage;
+  }
+  const char* name = comm->proxyState->ncclNet == NULL ? NULL : comm->proxyState->ncclNet->name;
+  if (name == NULL || (strcmp(name, "Socket") != 0 && strcmp(name, "IB") != 0)) {
+    WARN("ColdSnap in-place NET experiment requires NCCL's built-in Socket or IB backend (got %s)",
+         name == NULL ? "none" : name);
+    return ncclInvalidUsage;
+  }
+  if (strcmp(name, "IB") == 0) {
+    const char* release = getenv("NCCL_IB_RELEASE_ON_FINALIZE");
+    if (release == NULL || strcmp(release, "1") != 0) {
+      WARN("ColdSnap in-place NET requires NCCL_IB_RELEASE_ON_FINALIZE=1 for the IB backend");
+      return ncclInvalidUsage;
+    }
+    coldsnapUsedIb = true;
+  }
+  if (comm->proxyState->netContext == NULL && comm->netContext != NULL) {
+    WARN("ColdSnap in-place NET found inconsistent communicator/proxy NET contexts");
+    return ncclInvalidUsage;
+  }
+  return ncclSuccess;
+}
+
+static ncclResult_t coldsnapDetachSend(struct ncclProxyConnection* connection,
+                                       struct ncclProxyState* proxyState) {
+  if (connection->state != connConnected) return ncclInvalidUsage;
+  struct sendNetResources* resources = (struct sendNetResources*)connection->transportResources;
+  if (resources == NULL || resources->shared || resources->netDeviceHandle != NULL ||
+      !ncclIntruQueueEmpty(&connection->proxyMemHandleQueue)) {
+    WARN("ColdSnap in-place NET send connection is outside the exact transport qualification envelope");
+    return ncclInvalidUsage;
+  }
+  if (resources->checkpointDetached) return ncclSuccess;
+  for (int p = 0; p < NCCL_NUM_PROTOCOLS; p++) {
+    if (resources->buffers[p]) {
+      NCCLCHECK(proxyState->ncclNet->deregMr(resources->netSendComm, resources->mhandles[p]));
+      resources->mhandles[p] = NULL;
+      connection->mhandles[p] = NULL;
+    }
+  }
+  NCCLCHECK(proxyState->ncclNet->closeSend(resources->netSendComm));
+  resources->netSendComm = NULL;
+  resources->checkpointDetached = 1;
+  return ncclSuccess;
+}
+
+static ncclResult_t coldsnapDetachRecv(struct ncclProxyConnection* connection,
+                                       struct ncclProxyState* proxyState) {
+  if (connection->state != connConnected) return ncclInvalidUsage;
+  struct recvNetResources* resources = (struct recvNetResources*)connection->transportResources;
+  if (resources == NULL || resources->shared || resources->netDeviceHandle != NULL ||
+      !ncclIntruQueueEmpty(&connection->proxyMemHandleQueue)) {
+    WARN("ColdSnap in-place NET receive connection is outside the exact transport qualification envelope");
+    return ncclInvalidUsage;
+  }
+  if (resources->checkpointDetached) return ncclSuccess;
+  for (int p = 0; p < NCCL_NUM_PROTOCOLS; p++) {
+    if (resources->buffers[p]) {
+      NCCLCHECK(proxyState->ncclNet->deregMr(resources->netRecvComm, resources->mhandles[p]));
+      resources->mhandles[p] = NULL;
+      connection->mhandles[p] = NULL;
+    }
+  }
+  NCCLCHECK(proxyState->ncclNet->closeRecv(resources->netRecvComm));
+  resources->netRecvComm = NULL;
+  resources->checkpointDetached = 1;
+  return ncclSuccess;
+}
+
+static void coldsnapEndpointIdentity(struct coldsnapNcclNetEndpoint* endpoint, int senderRank, int receiverRank,
+                                     int channelId, int connIndex) {
+  memset(endpoint, 0, sizeof(*endpoint));
+  endpoint->structSize = sizeof(*endpoint);
+  endpoint->version = COLDSNAP_NCCL_NET_ENDPOINT_VERSION;
+  endpoint->senderRank = senderRank;
+  endpoint->receiverRank = receiverRank;
+  endpoint->channelId = channelId;
+  endpoint->connIndex = connIndex;
+}
+
+static bool coldsnapEndpointMatches(const struct coldsnapNcclNetEndpoint* endpoint, int senderRank, int receiverRank,
+                                    int channelId, int connIndex) {
+  return endpoint->structSize == sizeof(*endpoint) && endpoint->version == COLDSNAP_NCCL_NET_ENDPOINT_VERSION &&
+         endpoint->senderRank == senderRank && endpoint->receiverRank == receiverRank &&
+         endpoint->channelId == channelId && endpoint->connIndex == connIndex;
+}
+
+static ncclResult_t coldsnapRegisterSend(struct ncclProxyConnection* connection,
+                                         struct ncclProxyState* proxyState) {
+  struct sendNetResources* resources = (struct sendNetResources*)connection->transportResources;
+  for (int p = 0; p < NCCL_NUM_PROTOCOLS; p++) {
+    if (resources->buffers[p]) {
+#if CUDA_VERSION >= 11070
+      int type = NCCL_NET_MAP_DEV_MEM(&resources->map, buffs[p]) ? NCCL_PTR_CUDA : NCCL_PTR_HOST;
+      if (type == NCCL_PTR_CUDA && resources->useDmaBuf) {
+        int dmabufFd;
+        size_t dmaBufSize = resources->buffSizes[p];
+        ALIGN_SIZE(dmaBufSize, ncclOsGetPageSize());
+        CUCHECK(cuMemGetHandleForAddressRange((void*)&dmabufFd, (CUdeviceptr)resources->buffers[p], dmaBufSize,
+                                              CU_MEM_RANGE_HANDLE_TYPE_DMA_BUF_FD,
+                                              getHandleForAddressRangeFlags(resources->useGdr)));
+        NCCLCHECK(proxyState->ncclNet->regMrDmaBuf(resources->netSendComm, resources->buffers[p],
+                                                   resources->buffSizes[p], type, 0ULL, dmabufFd,
+                                                   &resources->mhandles[p]));
+        (void)close(dmabufFd);
+      } else
+#endif
+      {
+      NCCLCHECK(proxyState->ncclNet->regMr(resources->netSendComm, resources->buffers[p], resources->buffSizes[p],
+                                           NCCL_NET_MAP_DEV_MEM(&resources->map, buffs[p]) ? NCCL_PTR_CUDA :
+                                                                                           NCCL_PTR_HOST,
+                                           &resources->mhandles[p]));
+      }
+    }
+  }
+  resources->checkpointDetached = 0;
+  return ncclSuccess;
+}
+
+static ncclResult_t coldsnapRegisterRecv(struct ncclProxyConnection* connection,
+                                         struct ncclProxyState* proxyState) {
+  struct recvNetResources* resources = (struct recvNetResources*)connection->transportResources;
+  for (int p = 0; p < NCCL_NUM_PROTOCOLS; p++) {
+    if (resources->buffers[p]) {
+#if CUDA_VERSION >= 11070
+      int type = NCCL_NET_MAP_DEV_MEM(&resources->map, buffs[p]) ? NCCL_PTR_CUDA : NCCL_PTR_HOST;
+      if (type == NCCL_PTR_CUDA && resources->useDmaBuf) {
+        int dmabufFd;
+        size_t dmaBufSize = resources->buffSizes[p];
+        ALIGN_SIZE(dmaBufSize, ncclOsGetPageSize());
+        CUCHECK(cuMemGetHandleForAddressRange((void*)&dmabufFd, (CUdeviceptr)resources->buffers[p], dmaBufSize,
+                                              CU_MEM_RANGE_HANDLE_TYPE_DMA_BUF_FD,
+                                              getHandleForAddressRangeFlags(resources->useGdr)));
+        NCCLCHECK(proxyState->ncclNet->regMrDmaBuf(resources->netRecvComm, resources->buffers[p],
+                                                   resources->buffSizes[p], type, 0ULL, dmabufFd,
+                                                   &resources->mhandles[p]));
+        (void)close(dmabufFd);
+      } else
+#endif
+      {
+      NCCLCHECK(proxyState->ncclNet->regMr(resources->netRecvComm, resources->buffers[p], resources->buffSizes[p],
+                                           NCCL_NET_MAP_DEV_MEM(&resources->map, buffs[p]) ? NCCL_PTR_CUDA :
+                                                                                           NCCL_PTR_HOST,
+                                           &resources->mhandles[p]));
+      }
+    }
+  }
+  resources->checkpointDetached = 0;
+  return ncclSuccess;
+}
