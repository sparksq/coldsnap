+NCCL_API(ncclResult_t, ncclCheckpointNetResetGlobals);
+ncclResult_t ncclCheckpointNetResetGlobals() {
+  NCCLCHECK(bootstrapNetCheckpointReset());
+  NCCLCHECK(ncclNetSocketCheckpointReset());
+  if (coldsnapUsedIb) NCCLCHECK(ncclCheckpointIbReset());
+  return ncclSuccess;
+}
