+  }
+  struct bootstrapState* state = (struct bootstrapState*)comm->bootstrap;
+  if (!state->checkpointDetached) return ncclInvalidUsage;
+  NCCLCHECK(bootstrapNetInit());
+  NCCLCHECK(createListenSocket(comm, comm->magic, comm->proxyState->listenSock,
+                               state->peerProxyAddresses + state->rank, ncclSocketTypeProxy));
+  NCCLCHECK(ncclProxyCheckpointResume(comm));
+  return ncclSuccess;
+}
