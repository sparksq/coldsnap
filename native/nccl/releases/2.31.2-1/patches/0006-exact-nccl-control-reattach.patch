+NCCL_API(ncclResult_t, ncclCheckpointControlDetach, ncclComm_t comm);
+ncclResult_t ncclCheckpointControlDetach(ncclComm_t comm) {
+  if (comm == NULL || comm->endMagic != NCCL_MAGIC || comm->bootstrap == NULL || comm->proxyState == NULL) {
+    return ncclInvalidArgument;
+  }
+  struct bootstrapState* state = (struct bootstrapState*)comm->bootstrap;
+  if (state->unexpectedConnections != NULL || ncclParamBootstrapNetEnable()) {
+    WARN("ColdSnap in-place control checkpoint requires idle socket bootstrap state");
+    return ncclInvalidUsage;
+  }
+  NCCLCHECK(ncclProxyCheckpointDetach(comm));
+  if (!state->checkpointDetached) {
+    NCCLCHECK(ncclSocketClose(&STATE_RING(state, socket.send)));
+    NCCLCHECK(ncclSocketClose(&STATE_RING(state, socket.recv)));
+    NCCLCHECK(ncclSocketClose(&STATE_LISTEN(state, socket)));
+    NCCLCHECK(ncclSocketClose(&STATE_LISTEN(state, peerSocket)));
+    state->checkpointDetached = 1;
+  }
+  return ncclSuccess;
+}
