+ncclResult_t ncclProxyCheckpointDetach(struct ncclComm* comm) {
+  struct ncclProxyState* proxyState = comm == NULL ? NULL : comm->proxyState;
+  if (proxyState == NULL || proxyState->listenSock == NULL ||
+      proxyState->checkpointServiceState.load(std::memory_order_acquire) != proxyCheckpointActive ||
+      proxyState->expectedResponses != NULL) {
+    return ncclInvalidUsage;
+  }
+  proxyState->checkpointPeerIndex = -1;
+  if (proxyState->peerSocks != NULL) {
+    const int self = comm->topParentRanks[comm->rank];
+    for (int index = 0; index < proxyState->peerArraySize; index++) {
+      int ready = 0;
+      NCCLCHECK(ncclSocketReady(proxyState->peerSocks + index, &ready));
+      if (!ready) continue;
+      if (index != self || proxyState->checkpointPeerIndex != -1) {
+        WARN("ColdSnap in-place proxy checkpoint requires exactly one process-local control socket");
+        return ncclInvalidUsage;
+      }
+      proxyState->checkpointPeerIndex = index;
+    }
+  }
+  proxyState->checkpointServiceState.store(proxyCheckpointDetachRequested, std::memory_order_release);
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (proxyState->checkpointServiceState.load(std::memory_order_acquire) != proxyCheckpointDetached &&
+         std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::yield();
+  }
+  if (proxyState->checkpointServiceState.load(std::memory_order_acquire) != proxyCheckpointDetached) {
+    WARN("ColdSnap in-place proxy service did not reach the checkpoint boundary");
+    return ncclSystemError;
+  }
+  if (proxyState->checkpointPeerIndex != -1) {
+    NCCLCHECK(ncclSocketClose(proxyState->peerSocks + proxyState->checkpointPeerIndex));
+  }
+  return ncclSuccess;
+}
+
+ncclResult_t ncclProxyCheckpointResume(struct ncclComm* comm) {
+  struct ncclProxyState* proxyState = comm == NULL ? NULL : comm->proxyState;
+  if (proxyState == NULL || proxyState->listenSock == NULL ||
+      proxyState->checkpointServiceState.load(std::memory_order_acquire) != proxyCheckpointDetached) {
+    return ncclInvalidUsage;
+  }
+  proxyState->checkpointServiceState.store(proxyCheckpointResumeRequested, std::memory_order_release);
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+  while (proxyState->checkpointServiceState.load(std::memory_order_acquire) != proxyCheckpointActive &&
+         std::chrono::steady_clock::now() < deadline) {
+    std::this_thread::yield();
+  }
+  if (proxyState->checkpointServiceState.load(std::memory_order_acquire) != proxyCheckpointActive) {
+    WARN("ColdSnap in-place proxy service did not resume");
+    return ncclSystemError;
+  }
+  if (proxyState->checkpointPeerIndex != -1) {
+    struct ncclSocket* sock = proxyState->peerSocks + proxyState->checkpointPeerIndex;
+    NCCLCHECK(ncclSocketInit(sock, proxyState->peerAddresses + proxyState->checkpointPeerIndex,
+                             comm->sharedRes->magic, ncclSocketTypeProxy, comm->abortFlag));
+    NCCLCHECK(ncclSocketConnect(sock));
+  }
+  return ncclSuccess;
+}
