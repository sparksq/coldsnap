+// All monitor registrations must be released before freezing the process.
+NCCL_API(ncclResult_t, ncclCheckpointProgressIdle);
+ncclResult_t ncclCheckpointProgressIdle() {
+  std::lock_guard<std::mutex> lock(gpuProgressCounterMonitorsMu);
+  for (int device = 0; device < kRasMaxCudaDevices; ++device) {
+    if (gpuProgressCounterMonitors[device] != nullptr) return ncclInvalidUsage;
+  }
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclCheckpointProgressSuspend, ncclComm_t comm);
+ncclResult_t ncclCheckpointProgressSuspend(ncclComm_t comm) {
+  if (comm == nullptr) return ncclInvalidArgument;
+  NCCLCHECK(ncclProgressCounterMonitorDestroy(comm));
+  comm->gpuTimerOffsetNs = 0;
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclCheckpointProgressStatus, ncclComm_t comm, int* monitors, int* registered);
+ncclResult_t ncclCheckpointProgressStatus(ncclComm_t comm, int* monitors, int* registered) {
+  if (comm == nullptr || monitors == nullptr || registered == nullptr) return ncclInvalidArgument;
+  *monitors = 0;
+  *registered = 0;
+  std::lock_guard<std::mutex> lock(gpuProgressCounterMonitorsMu);
+  for (int device = 0; device < kRasMaxCudaDevices; ++device) {
+    auto* monitor = gpuProgressCounterMonitors[device];
+    if (monitor == nullptr) continue;
+    ++*monitors;
+    std::lock_guard<std::mutex> deviceLock(monitor->mutex);
+    for (auto* current = ncclIntruQueueHead(&monitor->registrations); current != nullptr;
+         current = current->nextProgressRegistration) {
+      if (current == comm) *registered = 1;
+    }
+  }
+  return ncclSuccess;
+}
