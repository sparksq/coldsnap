+NCCL_API(ncclResult_t, ncclCheckpointRasListen, ncclComm_t comm, struct rasRankInit* rank);
+ncclResult_t ncclCheckpointRasListen(ncclComm_t comm, struct rasRankInit* rank) {
+  if (comm == nullptr || rank == nullptr) return ncclInvalidArgument;
+  memset(rank, 0, sizeof(*rank));
+  if (ncclParamRasEnable() != 1) return ncclSuccess;
+  NCCLCHECK(bootstrapNetInit());
+  ncclCheckpointRefreshHostHash();
+  memcpy(&rank->addr, &bootstrapNetIfAddr, sizeof(rank->addr));
+  rank->pid = ncclOsGetPid();
+  rank->cudaDev = comm->cudaDev;
+  rank->nvmlDev = comm->nvmlDev;
+  rank->hostHash = getHostHash();
+  rank->pidHash = getPidHash();
+  return ncclRasCommInit(comm, rank);
+}
+
+NCCL_API(ncclResult_t, ncclCheckpointRasPublish, ncclComm_t comm, const struct rasRankInit* ranks, int count);
+ncclResult_t ncclCheckpointRasPublish(ncclComm_t comm, const struct rasRankInit* ranks, int count) {
+  if (comm == nullptr || ranks == nullptr || count != comm->nRanks) return ncclInvalidArgument;
+  if (ncclParamRasEnable() != 1) return ncclSuccess;
+  struct rasRankInit* owned;
+  NCCLCHECK(ncclCalloc(&owned, count));
+  memcpy(owned, ranks, count * sizeof(*owned));
+  ncclResult_t result = ncclRasAddRanks(owned, count);
+  if (result != ncclSuccess) free(owned);
+  return result;
+}
