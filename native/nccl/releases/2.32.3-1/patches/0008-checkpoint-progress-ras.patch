+
+NCCL_API(ncclResult_t, ncclCheckpointProgressResume, ncclComm_t comm);
+ncclResult_t ncclCheckpointProgressResume(ncclComm_t comm) {
+  if (comm == nullptr) return ncclInvalidArgument;
+  if (comm->deviceCountersBlock == nullptr && comm->hostCountersBlock == nullptr) return ncclSuccess;
+  if (comm->deviceCountersBlock == nullptr || comm->hostCountersBlock == nullptr) return ncclInvalidUsage;
+  CUDACHECK(cudaSetDevice(comm->cudaDev));
+  cudaStream_t stream;
+  CUDACHECK(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+  // Preserve graph-visible addresses, but start diagnostics in the destination's clock epoch.
+  cudaError_t error = cudaMemsetAsync(comm->deviceCountersBlock, 0, sizeof(*comm->deviceCountersBlock), stream);
+  if (error == cudaSuccess) error = cudaStreamSynchronize(stream);
+  if (error != cudaSuccess) {
+    (void)cudaStreamDestroy(stream);
+    return ncclUnhandledCudaError;
+  }
+  memset(comm->hostCountersBlock, 0, sizeof(*comm->hostCountersBlock));
+  comm->gpuTimerOffsetNs = progressCounterCalibrateGpuTimer(comm, stream);
+  CUDACHECK(cudaStreamDestroy(stream));
+  return ncclProgressCounterMonitorInit(comm);
+}
