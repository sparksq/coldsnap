+// Built-in RMA/GIN plugins allocate discovery contexts even before any device or
+// RMA API is used. Keep their logical plugin ownership and topology, but replace
+// these idle transport contexts at the checkpoint boundary.
+static ncclResult_t coldsnapCheckIdlePlugins(struct ncclComm* comm, bool attached) {
+  if (comm->sharedRes == nullptr || comm->sharedRes->owner != comm ||
+      COMPILER_ATOMIC_LOAD(&comm->sharedRes->refCount, std::memory_order_acquire) != 1)
+    return ncclInvalidUsage;
+  const auto& rma = comm->rmaState.rmaProxyState;
+  const auto& gin = comm->sharedRes->ginState;
+  if (rma.connected || rma.rmaInstance != nullptr || rma.rmaCommCount != 0 ||
+      rma.rmaProxyCtxCount != 0 || rma.rmaProxyCtxs != nullptr || rma.rmaProgress != 0 ||
+      rma.thread.joinable() || comm->rmaState.rmaCeState.initialized ||
+      gin.connected || gin.devComms != nullptr || gin.proxyThreadsCreated || gin.proxyNthreads != 0)
+    return ncclInvalidUsage;
+  if (rma.ncclRma != nullptr) {
+    if (rma.ncclRma != &ncclRmaIbProxy && rma.ncclRma != &ncclRmaSocketProxy) return ncclInvalidUsage;
+    if ((comm->rmaContext != nullptr) != attached) return ncclInvalidUsage;
+  } else if (comm->rmaContext != nullptr) {
+    return ncclInvalidUsage;
+  }
+  for (int i = 0; i < NCCL_GIN_MAX_CONNECTIONS; ++i) {
+    if (rma.rmaComms[i] != nullptr || gin.thread[i].joinable()) return ncclInvalidUsage;
+  }
+  bool usesIb = rma.ncclRma == &ncclRmaIbProxy;
+  for (int i = 0; i < gin.numActiveBackends; ++i) {
+    const auto& backend = gin.backends[i];
+    if (backend.ncclGin != &ncclGinIbGdaki && backend.ncclGin != &ncclGinProxy) return ncclInvalidUsage;
+    if ((backend.ginInstance != nullptr) != attached || backend.ginCommCount != 0) return ncclInvalidUsage;
+    for (int j = 0; j < NCCL_GIN_MAX_CONNECTIONS; ++j) {
+      if (backend.ginComms[j] != nullptr) return ncclInvalidUsage;
+    }
+    usesIb |= backend.ncclGin == &ncclGinIbGdaki;
+  }
+  if (usesIb) {
+    const char* release = getenv("NCCL_IB_RELEASE_ON_FINALIZE");
+    if (release == nullptr || strcmp(release, "1") != 0) return ncclInvalidUsage;
+  }
+  return ncclSuccess;
+}
+
+static ncclResult_t coldsnapSuspendIdlePlugins(struct ncclComm* comm) {
+  NCCLCHECK(coldsnapCheckIdlePlugins(comm, true));
+  auto& gin = comm->sharedRes->ginState;
+  auto* rma = comm->rmaState.rmaProxyState.ncclRma;
+  if (rma == &ncclRmaIbProxy) coldsnapUsedIb = true;
+  for (int i = 0; i < gin.numActiveBackends; ++i) {
+    auto& backend = gin.backends[i];
+    if (backend.ncclGin == &ncclGinIbGdaki) coldsnapUsedIb = true;
+    NCCLCHECK(backend.ncclGin->finalize(backend.ginInstance));
+    backend.ginInstance = nullptr;
+  }
+  if (rma != nullptr) {
+    NCCLCHECK(rma->finalize(comm->rmaContext));
+    comm->rmaContext = nullptr;
+  }
+  return ncclSuccess;
+}
+
+static ncclResult_t coldsnapResumeIdlePlugins(struct ncclComm* comm) {
+  NCCLCHECK(coldsnapCheckIdlePlugins(comm, false));
+  auto* rma = comm->rmaState.rmaProxyState.ncclRma;
+  if (rma != nullptr) {
+    int expected = 0, actual = 0, unused = 0;
+    NCCLCHECK(ncclRmaGetDevCount(comm->rmaPluginIndex, &expected, &unused));
+    NCCLCHECK(rma->init(&comm->rmaContext, comm->commHash, ncclDebugLog));
+    NCCLCHECK(rma->devices(&actual));
+    if (actual != expected) {
+      WARN("ColdSnap idle RMA restore changed device count from %d to %d", expected, actual);
+      return ncclInvalidUsage;
+    }
+  }
+  auto& gin = comm->sharedRes->ginState;
+  for (int i = 0; i < gin.numActiveBackends; ++i) {
+    auto& backend = gin.backends[i];
+    int expected = 0, actual = 0, unused = 0;
+    NCCLCHECK(ncclGinGetDevCount(backend.pluginIndex, &expected, &unused));
+    NCCLCHECK(backend.ncclGin->init(&backend.ginInstance, comm->commHash, ncclDebugLog));
+    NCCLCHECK(backend.ncclGin->devices(&actual));
+    if (actual != expected) {
+      WARN("ColdSnap idle GIN restore changed device count from %d to %d", expected, actual);
+      return ncclInvalidUsage;
+    }
+  }
+  return ncclSuccess;
+}
