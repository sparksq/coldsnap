+    ncclIbPeerMemModuleChecked = true;
+  }
   if (!ncclIbPeerMemModuleLoaded) return ncclSystemError;
   return ncclSuccess;
 }
 
+// Re-evaluate destination kernel-module availability after every checkpoint.
+void ncclIbGdrCheckpointReset() {
+  std::lock_guard<std::mutex> lock(ncclIbGdrModuleMutex);
+  ncclIbGdrModuleChecked = ncclIbPeerMemModuleChecked = false;
+  ncclIbGdrModuleLoaded = ncclIbPeerMemModuleLoaded = 0;
+}
