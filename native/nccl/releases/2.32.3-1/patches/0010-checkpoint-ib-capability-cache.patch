+  std::lock_guard<std::mutex> lock(ncclIbDmaBufSupportMutex);
+  if (dev < 0 || dev >= ncclNMergedIbDevs) return ncclInvalidArgument;
+  ncclIbMergedDev* mergedDev = ncclIbMergedDevs + dev;
+  if (mergedDev->vProps.ndevs <= 0 || mergedDev->vProps.devs[0] < 0 ||
+      mergedDev->vProps.devs[0] >= ncclNIbDevs) return ncclInvalidArgument;
   ncclIbDev* ibDev = ncclIbDevs + mergedDev->vProps.devs[0];
+  // The result belongs to the opened device, not to the lifetime of the process.
