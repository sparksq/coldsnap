+static std::mutex ncclIbGdrModuleMutex;
+static bool ncclIbGdrModuleChecked = false;
+static bool ncclIbPeerMemModuleChecked = false;
 static int ncclIbGdrModuleLoaded = 0; // 1 = true, 0 = false
 static void ibGdrSupportInitOnce() {
   // Check for the nv_peer_mem module being loaded
@@ -22,8 +26,11 @@ static void ibGdrSupportInitOnce() {
 
 // Returns ncclSuccess if any of the peermem modules are loaded.
 ncclResult_t ncclIbGdrSupport() {
-  static std::once_flag once;
-  std::call_once(once, ibGdrSupportInitOnce);
+  std::lock_guard<std::mutex> lock(ncclIbGdrModuleMutex);
+  if (!ncclIbGdrModuleChecked) {
+    ibGdrSupportInitOnce();
+    ncclIbGdrModuleChecked = true;
+  }
   if (!ncclIbGdrModuleLoaded) return ncclSystemError;
   return ncclSuccess;
 }
@@ -36,12 +43,23 @@ static void ibPeerMemSupportInitOnce() {
 // Returns ncclSuccess if nvidia_peermem module is loaded. Does not check legacy implementations of nv_peer_mem
