+
+// Called only after every communicator/control-plane transport is detached.
+// Reject unowned live connections rather than checkpointing an SSL session.
+NCCL_API(ncclResult_t, ncclCheckpointCryptReset);
+ncclResult_t ncclCheckpointCryptReset() {
+  std::lock_guard<std::mutex> lock(ncclCryptLock);
+  if (ncclCryptActiveConnections != 0) return ncclInvalidUsage;
+#if defined(NCCL_TLS_BACKEND_OPENSSL3)
+  cryptFreeLibObjects();
+  ncclCryptNeedsReseed = ncclCryptLibCtx != nullptr;
+#endif
+  return ncclSuccess;
+}
+
+NCCL_API(ncclResult_t, ncclCheckpointCryptStatus, int* compiled, size_t* active, int* ready, int* reseed);
+ncclResult_t ncclCheckpointCryptStatus(int* compiled, size_t* active, int* ready, int* reseed) {
+  if (compiled == nullptr || active == nullptr || ready == nullptr || reseed == nullptr)
+    return ncclInvalidArgument;
+  std::lock_guard<std::mutex> lock(ncclCryptLock);
+  *active = ncclCryptActiveConnections;
+#if defined(NCCL_TLS_BACKEND_OPENSSL3)
+  *compiled = 1;
+  *ready = ncclCryptLibReady;
+  *reseed = ncclCryptNeedsReseed;
+#else
+  *compiled = *ready = *reseed = 0;
+#endif
+  return ncclSuccess;
+}
